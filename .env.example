# Use python scripts/init_env.py to create separate random credentials for local use.
APP_ADMIN_PASSWORD=<GENERATE_ADMIN_PASSWORD>
APP_OPERATOR_PASSWORD=<GENERATE_OPERATOR_PASSWORD>
AGENT_TOKEN=<GENERATE_AGENT_TOKEN>
DEMO_CONTROL_TOKEN=<GENERATE_CONTROL_TOKEN>
EVIDENCE_TOKEN=<GENERATE_EVIDENCE_TOKEN>
HOLMES_API_KEY=<GENERATE_HOLMES_TOKEN>
AGENT_MODE=offline
# Set locally only when enabling the optional HolmesGPT profile.
OPENAI_API_KEY=
APP_PORT=18760
CHECKOUT_PORT=18761
# Set only behind a trusted TLS reverse proxy. Keep empty for local HTTP.
APP_PUBLIC_ORIGIN=

# Optional for local MFA enrollment: stable Base64-encoded 32 random bytes. Production generates its secret file.
APP_MFA_KEY=

# Required only for manual paid investigations; held costs remain reserved until reconciled.
MODEL_DAILY_BUDGET_USD=
MODEL_RESERVATION_USD=
