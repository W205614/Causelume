local.file_match "service_logs" {
  path_targets = [
    { "__path__" = "/var/log/causelume/app.log", "service" = "causelume", "environment" = "local" },
    { "__path__" = "/var/log/causelume/example.log", "service" = "example-service", "environment" = "local" },
  ]
  sync_period = "2s"
}

loki.source.file "services" {
  targets    = local.file_match.service_logs.targets
  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
